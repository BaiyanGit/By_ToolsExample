{
    "groups":  [
                   {
                       "key":  "VideoFormat",
                       "settingName":  "视频格式",
                       "options":  [
                                       {
                                           "option":  "webm",
                                           "description":  "适合 Unity 内播放和跨平台分发。"
                                       },
                                       {
                                           "option":  "mp4",
                                           "description":  "兼容性更广，适合常规播放器和交付。"
                                       }
                                   ]
                   },
                   {
                       "key":  "useMode",
                       "settingName":  "使用方式",
                       "options":  [
                                       {
                                           "option":  "存储本地",
                                           "description":  "将录制内容保存为本地视频文件。"
                                       },
                                       {
                                           "option":  "视频推流",
                                           "description":  "将录制画面实时推送到 RTMP 或 RTMPS 地址。"
                                       }
                                   ]
                   },
                   {
                       "key":  "audioMode",
                       "settingName":  "音频采集模式",
                       "options":  [
                                       {
                                           "option":  "静音录制",
                                           "description":  "只录制画面，不采集系统音频。"
                                       },
                                       {
                                           "option":  "系统音频",
                                           "description":  "本地录屏通过 WASAPILoopbackRecorder.dll 录制系统输出声音，停止后再与视频合并。"
                                       }
                                   ]
                   },
                   {
                       "key":  "audioCodec",
                       "settingName":  "音频编码器",
                       "options":  [
                                       {
                                           "option":  "aac",
                                           "description":  "MP4 和 RTMP 推流常用编码器。"
                                       },
                                       {
                                           "option":  "libvorbis",
                                           "description":  "WebM 默认推荐。"
                                       },
                                       {
                                           "option":  "libopus",
                                           "description":  "WebM 低码率质量更好。"
                                       }
                                   ]
                   },
                   {
                       "key":  "AudioGainEnabled",
                       "settingName":  "录制音量增强",
                       "options":  [
                                       {
                                           "option":  "使用",
                                           "description":  "录制声音偏小时启用，会在 FFmpeg 音频链路中追加 volume 滤镜。"
                                       },
                                       {
                                           "option":  "不使用",
                                           "description":  "不改变录制音量，保持原始采集音量。"
                                       }
                                   ]
                   },
                   {
                       "key":  "AudioGainDb",
                       "settingName":  "录制音量增益",
                       "options":  [
                                       {
                                           "option":  "-20 dB",
                                           "description":  "显著降低音量，适合输入过大的场景。"
                                       },
                                       {
                                           "option":  "-12 dB",
                                           "description":  "明显降低音量。"
                                       },
                                       {
                                           "option":  "-9 dB",
                                           "description":  "中等降低音量。"
                                       },
                                       {
                                           "option":  "-6 dB",
                                           "description":  "轻度降低音量。"
                                       },
                                       {
                                           "option":  "-3 dB",
                                           "description":  "轻微降低音量。"
                                       },
                                       {
                                           "option":  "0 dB",
                                           "description":  "不增不减，默认安全值。"
                                       },
                                       {
                                           "option":  "3 dB",
                                           "description":  "轻微增大音量。"
                                       },
                                       {
                                           "option":  "6 dB",
                                           "description":  "明显增大音量，约 2 倍，是常用起始值。"
                                       },
                                       {
                                           "option":  "9 dB",
                                           "description":  "较大增益，需要留意是否破音。"
                                       },
                                       {
                                           "option":  "12 dB",
                                           "description":  "很大增益，建议确认不会削波后再使用。"
                                       },
                                       {
                                           "option":  "20 dB",
                                           "description":  "极大增益，仅适合输入非常小且已开启限幅保护的场景。"
                                       }
                                   ]
                   },
                   {
                       "key":  "StreamIncludeAudio",
                       "settingName":  "推流包含音频",
                       "options":  [
                                       {
                                           "option":  "使用",
                                           "description":  "Windows 推流包含系统音频需要当前 FFmpeg 支持 wasapi 输入。本地 MP4/WebM 录屏音频由 WASAPILoopbackRecorder.dll 录 WAV 后再 Merge，和实时推流音频不是同一路径。Linux/国产系统按 pulse、alsa、pipewire 或当前系统 FFmpeg 编译能力判断。"
                                       },
                                       {
                                           "option":  "不使用",
                                           "description":  "只推送画面，默认推荐先验证视频推流链路。Windows 当前 FFmpeg 不支持 wasapi 时请保持关闭；Linux 不使用 wasapi 判断。"
                                       }
                                   ]
                   },
                   {
                       "key":  "AudioLimiter",
                       "settingName":  "音频限幅器",
                       "options":  [
                                       {
                                           "option":  "使用",
                                           "description":  "增益后追加 alimiter=limit=0.95，降低爆音和削波风险；FFmpeg 不支持时会自动降级。"
                                       },
                                       {
                                           "option":  "不使用",
                                           "description":  "只使用 volume 增益，性能更简单但更容易过载。"
                                       }
                                   ]
                   }
               ]
}
